function drawLeafCluster(){
    const numberOfLeaves = floor(random(3, 7));

    for (let i = 0; i < numberOfLeaves; i++){
        push();
        rotate(random(360));
        let leafSize = random(18, 35);
        drawLeaf(leafSize);
        pop();
    }
}

function drawLeaf(size) {

    const leafColor = color(
    random(96, 225),
    random(167, 214),
    random(18, 0)
  );

  fill(leafColor);
  strokeWeight(2);
  stroke(129, 234, 108); 

  beginShape();
  vertex(0, 0);
  vertex(-size * 0.27, size * 0.18);
  vertex(-size * 0.32, size * 0.4);
  vertex(0, size + 8);
  vertex(size * 0.32, size * 0.4);
  vertex(size * 0.27, size * 0.18);
  endShape(CLOSE);

  stroke(129, 234, 108);
  strokeWeight(1);
  line(0, 0, 0, size + 10);

}
